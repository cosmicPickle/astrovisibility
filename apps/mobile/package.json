{
  "name": "@astrovisibility/mobile",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start:dev": "expo start",
    "android:dev": "expo run:android",
    "android:prebuild": "expo prebuild --platform android --no-install && node scripts/applyAndroidBuildFix.ts",
    "catalogue:check": "node scripts/catalogue/checkCatalogue.ts",
    "catalogue:generate": "node scripts/catalogue/generateCatalogue.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:e2e:android": "maestro test e2e/maestro",
    "build": "node scripts/catalogue/checkCatalogue.ts && expo export --platform android --output-dir dist"
  },
  "dependencies": {
    "@gluestack-ui/core": "5.0.15",
    "@gluestack-ui/utils": "5.0.6",
    "astronomy-engine": "2.1.19",
    "expo": "57.0.2",
    "expo-camera": "57.0.3",
    "expo-constants": "57.0.11",
    "expo-file-system": "57.0.0",
    "expo-image-picker": "57.0.2",
    "expo-linking": "57.0.4",
    "expo-location": "57.0.11",
    "expo-router": "57.0.8",
    "expo-sensors": "57.0.2",
    "expo-sqlite": "57.0.0",
    "expo-status-bar": "57.0.0",
    "nativewind": "5.0.0-preview.4",
    "react": "19.2.8",
    "react-native": "0.86.0",
    "react-native-css": "3.0.4",
    "react-native-gesture-handler": "3.0.2",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "5.8.0",
    "react-native-screens": "4.26.0",
    "react-native-svg": "15.15.5",
    "react-native-worklets": "0.10.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "26.2.0",
    "@types/react": "19.2.15",
    "babel-preset-expo": "57.0.1",
    "eslint": "10.6.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.6.0",
    "jest": "29.7.0",
    "jest-expo": "57.0.1",
    "react-test-renderer": "19.2.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1"
  }
}
